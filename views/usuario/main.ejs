<!-- views/usuario/controleLanches.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Lanches</title>
    <link rel="stylesheet" href="/assets/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="/assets/js/mqtt/mqttController.js" defer></script>
</head>
<body class="relatorio">
    <%- include('../layouts/header') %>
  
    <main>
      <h1>Lanches Distribuídos</h1>
      
      <!-- Campo de Pesquisa -->
      <div class="search-container">
        <input type="text" placeholder="Filtrar Relatório..." id="search">
        <button type="button" id="search-button">
          <i class="fas fa-search"></i>
        </button>
      </div>
  
      <!-- Espaço para Tabela de Relatórios (Em Branco) -->
      <table class="tabela-relatorio" id="relatorios-table">
        <thead>
          <tr>
            <th>Data</th>
            <th>Quantidade de Alunos</th>
          </tr>
        </thead>
        <tbody>
          <!-- Nenhum dado preenchido -->
        </tbody>
      </table>
    </main>  
  
    <%- include('../layouts/footer') %>
    <script type="module" src="/assets/js/main.js"></script>
  </body>  
</html>